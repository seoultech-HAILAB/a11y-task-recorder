{
  "manifest_version": 3,
  "name": "A11y Task Recorder",
  "version": "0.2.1",
  "description": "NVDA 웹 과업 평가를 위해 URL 전환과 DOM 변화를 로컬에 기록합니다.",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "A11y Task Recorder",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "commands": {
    "mark-issue": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "현재 지점을 불편 지점으로 표시"
    }
  }
}
